# NEXUS — environment template
#
# Copy to `.env.local` (gitignored) and fill in real values. Every value here is a PLACEHOLDER;
# no working secret is committed.
#
# Two rules this file exists to enforce:
#
#   1. Nothing secret is ever prefixed `NEXT_PUBLIC_`. Next.js inlines every `NEXT_PUBLIC_*` value
#      into the client bundle, so a session key or an API key placed there is published to every
#      visitor. This app has no `NEXT_PUBLIC_*` variables, and that is deliberate.
#   2. The server reads these at request time. Only the Companion extension's API origin is baked
#      into a build artefact, and that is a public URL, not a secret.
#
# Values are validated at startup when they matter: a configuration that would silently weaken the
# security model becomes a hard boot failure rather than a surprise in production.

# ---------------------------------------------------------------------------- runtime ----------

# Port the web server binds. Defaults to 3000. The Companion's manifest allow-lists the API origin
# at build time, so changing this means rebuilding the extension with a matching NEXUS_API_ORIGIN.
PORT=3000

# Node environment. `production` enables the production build path, which refuses the embedded
# database unless NEXUS_ALLOW_EMBEDDED_IN_PRODUCTION is also set (see below).
NODE_ENV=production

# ------------------------------------------------------------------------ database -------------

# External PostgreSQL / Supabase connection string.
#
# OPTIONAL. When neither SUPABASE_DB_URL nor DATABASE_URL is set, the app runs an embedded PGlite
# database instead (see NEXUS_DATA_DIR). Set exactly one connection string when deploying against a
# real Postgres instance.
#
# SECRET — contains the database password. Server-side only. Never log it.
# SUPABASE_DB_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@db.REPLACE_WITH_PROJECT_REF.supabase.co:5432/postgres
# DATABASE_URL=postgresql://nexus:REPLACE_WITH_PASSWORD@127.0.0.1:5432/nexus

# Embedded PGlite data directory. OPTIONAL; defaults to `<app>/.data/nexus`.
# NON-SECRET, but it is NOT portable across hosts: the directory is the whole database. On a host
# with an ephemeral filesystem it is lost on every redeploy, so it must sit on a persistent volume
# (or be replaced by SUPABASE_DB_URL / DATABASE_URL).
# NEXUS_DATA_DIR=/var/lib/nexus/data

# Directory holding the `.sql` migration files. OPTIONAL — set it only when the migrations are not
# discoverable relative to the app (containers and CI). NON-SECRET.
# NEXUS_MIGRATIONS_DIR=/app/packages/db/migrations

# -------------------------------------------------------------------------- sessions ------------

# Signing key for the session cookie. REQUIRED in production.
#
# If unset, `serve.mjs` generates one on first boot and writes it to `.env.local`. That is fine for a
# single long-lived machine but WRONG behind an autoscaler: a new instance with a fresh random key
# invalidates every existing session, silently signing all operators out.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# SECRET — rotating it invalidates all sessions. Server-side only.
# NEXUS_SESSION_SECRET=REPLACE_WITH_A_32_BYTE_BASE64URL_VALUE

# Enables the email + password sign-in path. OPTIONAL; defaults to on for local development.
# Set to `0` when identity is meant to come from an external provider only: with it off,
# `/api/auth/login` refuses rather than falling back to a password check.
# NON-SECRET.
# NEXUS_LOCAL_AUTH=1

# Permits the embedded PGlite database while NODE_ENV=production. OPTIONAL; must be set explicitly.
#
# This is a deliberate override, not a default. The embedded engine is single-process, so two
# instances sharing one data directory corrupt it — which is exactly the failure the production
# guard exists to prevent. Set it only for a single-instance deployment on a persistent volume.
# NON-SECRET.
# NEXUS_ALLOW_EMBEDDED_IN_PRODUCTION=1

# Serves the static Companion preview under /api/companion-preview. OPTIONAL; OFF unless set to `1`.
# Leave unset in production: it exists to preview the panel without loading the extension.
# NON-SECRET.
# NEXUS_COMPANION_PREVIEW=1

# ------------------------------------------------------------------------------- AI -------------

# DeepSeek provider credentials for message drafting and profile extraction.
#
# ALL OPTIONAL. A missing key is a NORMAL deployment state, not an error: the drafting action returns
# a typed `provider_not_configured` result and the UI renders it as "AI drafting is not configured on
# this deployment". The local profile-extraction fallback also continues to work without a key.
#
# DEEPSEEK_API_KEY is SECRET — server-side only. It is never sent to the browser, and provider error
# bodies are passed through `redactSecrets` before reaching logs.
# DEEPSEEK_API_KEY=REPLACE_WITH_PROVIDER_KEY
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --------------------------------------------------------------------- extension build ----------

# API origin baked into the Companion extension at build time.
#
# This is a BUILD-TIME variable for `pnpm --filter @nexus/extension run build`, not a server
# variable. It is written into the generated `manifest.json` `host_permissions` and into the bundled
# config, so changing it REQUIRES REBUILDING the extension and reloading it in Chrome.
#
# A production build REFUSES a loopback origin and requires https. Defaults to
# `http://127.0.0.1:3000` for development only.
# PUBLIC (not a secret) — it is a URL every panel request goes to.
# NEXUS_API_ORIGIN=https://app.example.com
