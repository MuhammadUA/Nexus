# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Dependencies
node_modules/

# Local environment and secrets
.env.local
.env*.local
.env

# Embedded database (PGlite) and local runtime state.
#
# The bare-directory patterns below only match a directory named exactly `.data`. Two PGlite data
# directories named `.data-corrupt-<stamp>` and `.data-broken-<stamp>` therefore slipped past them and
# were committed to this repository, adding ~88 MiB and 2,706 files of duplicated, regenerable
# database state. The glob patterns that follow cover every `.data*` variant — including any future
# diagnostic copy taken with a suffix — so a renamed data directory can never be tracked again.
#
# These have no trailing slash on purpose: a trailing slash matches directories only, whereas the
# `.data*` forms also catch a stray lock or config file written beside the directory.
apps/web/.data/
.data/
.data*/
**/.data/
**/.data*/
apps/web/.data-*
**/.data-*
!**/.data.example/

# Scratch / decode work
.work/
CRM/.work/

# Test + tooling output
coverage/
.vitest/
*.log
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# TypeScript build info emitted by incremental tsc
packages/*/tsconfig.tsbuildinfo
apps/*/tsconfig.tsbuildinfo

# Local UI/browser audit output
ui-audit/
playwright-report/
test-results/

# Verification harness output.
#
# The scripts under `scripts/baseline-verify/` are kept because they are the reproducible record of
# the API/MCP baseline run: `harness.mjs` drives the live endpoint, `report.mjs` renders the docs and
# `results.json` holds the recorded exchanges. What must never be committed is what they *emit* — in
# particular `secrets.json`, which contains raw live `nxs_` service tokens created for the run, plus
# the token cookies and logs. Those are generated, contain working credentials, and are recreated by
# re-running the harness.
scripts/baseline-verify/secrets.json
**/secrets.json
**/*-cookie.txt
**/cookie.txt
**/.verify-hold/
**/.verify-hold-log.txt
**/tsconfig.*-check.json

# Ignore all environment variants except templates
.env.*
!.env.example
!.env.*.example
.vercel
