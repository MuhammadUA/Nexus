# Local development configuration.
#
# Copy to `.env.local` and adjust. `.env.local` is git-ignored.

# Supabase / PostgreSQL connection for the production data path.
# Leave unset to use the embedded PostgreSQL (PGlite) driver, which persists to
# apps/web/.data/. That path is single-process only — a real deployment MUST set
# this, and `assertRuntimePosture()` refuses to start a production build without it.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth is the production auth provider (spec
# `security_and_reliability.stack.auth`). The app reads the resulting `userId`
# from the session and publishes it to PostgreSQL as `request.jwt.claims`, which
# is exactly what Supabase's `auth.uid()` reads, so RLS behaves identically.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Secret used to sign the session cookie. REQUIRED in production; a fixed
# development fallback is used otherwise so restarting the dev server does not
# sign every developer out.
# NEXUS_SESSION_SECRET=<at least 32 random bytes, base64>

# Enables the local email/password credential path (migration 0015). Off by
# default so a misconfigured production deploy cannot accept local passwords.
NEXUS_LOCAL_AUTH=1
