{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "rootDir": ".",
    // `scripts/*.ts` run under `node --experimental-strip-types`, which requires
    // explicit `.ts` specifiers rather than TypeScript's usual extensionless or
    // `.js` style.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
